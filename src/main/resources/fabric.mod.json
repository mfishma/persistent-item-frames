  "authors": [
    "Chino_47",
    "mfishma"
  ],
  "contact": {
    "sources": "https://github.com/mfishma/persistent-item-frames"
  },
  "license": "AFL-3.0",
  "icon": "assets/persistent-item-frames/icon.png",
  "environment": "client",
  "entrypoints": {},
  "mixins": [
    "persistentframes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=26.1",
    "java": ">=25"
  }
}
